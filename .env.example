# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# Blog reading font — must match a font imported in frontend/src/app/layout.tsx
NEXT_PUBLIC_BLOG_FONT=Source_Serif_4
# Google Search Console verification token for gradevitian.jayaremala.com.
# Add the property in Search Console, pick the "HTML tag" method, and paste ONLY
# the content value here (not the whole <meta> tag). Also set it as a GitHub
# Actions secret of the same name — the build bakes it into the gradeVITian pages.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# Google Sign-In for gradeVITian — the OAuth 2.0 *Web application* client ID from
# Google Cloud Console. Its "Authorized JavaScript origins" must list every origin
# the button is served from (http://localhost:3000, https://gradevitian.jayaremala.com,
# https://jayaremala.com). No redirect URI is needed — this is the ID-token flow.
# Must match GV_GOOGLE_CLIENT_ID below; leave both empty to hide the button.
# Also add it as a GitHub Actions secret of the same name — the value is baked in
# at build time.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Backend
APP_ENV=dev
FRONTEND_ORIGIN=http://localhost:3000

# Public MCP server host allow-list (fastmcp >= 3.4.3 rejects any Host not in
# this list with 421 "Misdirected Request" — DNS-rebinding protection). The
# defaults 127.0.0.1/localhost/::1 are always allowed, so this is only needed
# for the public domain in production. JSON array; supports fnmatch wildcards.
# PROD: FASTMCP_HTTP_ALLOWED_HOSTS=["api.jayaremala.com"]
# FASTMCP_HTTP_ALLOWED_HOSTS=

# Google AI
GOOGLE_API_KEY=
# Primary model — falls back through GEMINI_FALLBACK_MODELS on 503/429
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODELS=gemini-2.0-flash,gemini-2.0-flash-lite,gemini-flash-latest

# gradeVITian Google Sign-In — same client ID as NEXT_PUBLIC_GOOGLE_CLIENT_ID above.
# The backend verifies that ID tokens sent to POST /gv/auth/google were issued for
# it. Empty falls back to GOOGLE_OAUTH_CLIENT_ID; if that is empty too the endpoint
# returns 503 and the frontend hides the button.
GV_GOOGLE_CLIENT_ID=

# Admin desk (/admin) — Google accounts allowed in, comma-separated. Sign-in needs
# GV_GOOGLE_CLIENT_ID (above) as well; the ID token's verified email must be listed
# here or the session is refused. ADMIN_TOKEN below still works as a machine /
# break-glass credential; set at least one of the two or the admin API reports
# itself disabled.
# No default — unset means nobody can sign in (fails closed).
ADMIN_EMAILS=you@example.com
# Signs admin session tokens. Falls back to GV_JWT_SECRET when unset.
ADMIN_JWT_SECRET=

# Persistent analytics DB — on Railway set to absolute path on persistent volume
# e.g. ANALYTICS_DB_PATH=/data/analytics.db
ANALYTICS_DB_PATH=./chroma_db/analytics.db
